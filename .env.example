# Copy to .env and fill in. .env is git-ignored.

# ---------- MinIO (Delta Lake object store) ----------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_LAKEHOUSE=nepse-lakehouse
MINIO_BUCKET_SNAPSHOTS=raw-snapshots

# ---------- Postgres (serving + operational) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nepse
POSTGRES_PASSWORD=nepse
POSTGRES_DB=nepse
POSTGRES_URL=postgresql://nepse:nepse@localhost:5432/nepse

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Compute engine ----------
# duckdb (local/prototype) | spark (production)
COMPUTE_ENGINE=duckdb

# ---------- LLM (Vertex AI via API key; single provider today) ----------
# Get a key: GCP Console → Vertex AI → Vertex AI Studio → API Keys.
# Do NOT commit .env (it's gitignored); .env.example is the template.
GCP_VERTEX_API_KEY=
GCP_PROJECT_ID=
GCP_REGION=global
LLM_INTENT_MODEL=gemini-2.5-flash-lite
LLM_SYNTHESIZER_MODEL=gemini-2.5-pro

# ---------- SMTM Data API (live NEPSE feed) ----------
# Credentials provided by client (LaganiSutra/SMTM). Token lives 15 min; refresh extends it.
SMTM_BASE_URL=https://dataapi.smtmcapital.com.np
SMTM_USERNAME=
SMTM_PASSWORD=
SMTM_RATE_LIMIT_PER_MIN=100

# ---------- Embeddings ----------
EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ---------- Observability ----------
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------- Email alert notifications (speculation alerts) ----------
# Until enabled, alerts evaluate + log but send nothing.
# Provider: "resend" (recommended) | "sendgrid" | "smtp".
NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_PROVIDER=resend
NOTIFICATIONS_FROM_EMAIL=onboarding@resend.dev   # a verified sender (or onboarding@resend.dev for Resend testing)
NOTIFICATIONS_FROM_NAME=NIMB Ace Alerts
# API-key transports (Resend / SendGrid):
NOTIFICATIONS_API_KEY=
# SMTP transport (only if NOTIFICATIONS_PROVIDER=smtp; Gmail needs an App Password):
NOTIFICATIONS_SMTP_HOST=smtp.gmail.com
NOTIFICATIONS_SMTP_PORT=587
NOTIFICATIONS_SMTP_USERNAME=
NOTIFICATIONS_SMTP_PASSWORD=
